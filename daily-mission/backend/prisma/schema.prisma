generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  password     String?
  googleId     String?  @unique
  role         String   @default("STUDENT")
  streak       Int      @default(0)
  examMode     String?  @default("NEET")
  dailyHours   Int      @default(4)
  targetRank   Int?
  weakSubjects String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes          Note[]
  analytics      Analytics[]
  studyPlans     StudyPlan[]
  mcqAttempts    McqAttempt[]
  revisions      Revision[]
  mockScores     MockScore[]
  quizzes        Quiz[]
  studySessions  StudySession[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  chatMessages   ChatMessage[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Chapter {
  id              Int     @id @default(autoincrement())
  year            String
  subject         String
  name            String
  description     String?
  difficulty      String  @default("MEDIUM")
  weightageLevel  String  @default("MEDIUM")
  weightage       Int     @default(5)
  linkedChapters  String?
  isHighPriority  Boolean @default(false)
  isRankBooster   Boolean @default(false)
  isMostDifficult Boolean @default(false)
  orderIndex      Int     @default(0)

  notes     Note[]
  mcqs      Mcq[]
  revisions Revision[]

  @@unique([year, subject, name])
}

model Note {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  subject     String
  highlights  String?
  memoryTrick String?
  isFavorite  Boolean  @default(false)
  isShared    Boolean  @default(false)
  chapterId   Int?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mcq {
  id            Int          @id @default(autoincrement())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  explanation   String?
  difficulty    String       @default("MEDIUM")
  subject       String
  questionType  String       @default("MCQ")
  chapterId     Int?
  chapter       Chapter?     @relation(fields: [chapterId], references: [id])
  attempts      McqAttempt[]
}

model McqAttempt {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcqId          Int
  mcq            Mcq      @relation(fields: [mcqId], references: [id])
  selectedOption String
  isCorrect      Boolean
  timeSpentSec   Int      @default(0)
  createdAt      DateTime @default(now())
}

model Formula {
  id       Int     @id @default(autoincrement())
  subject  String
  title    String
  content  String
  category String  @default("general")
  shortcut String?
  imageUrl String?
}

model Diagram {
  id       Int    @id @default(autoincrement())
  subject  String
  title    String
  imageUrl String
  labels   String
  category String @default("general")
}

model Handbook {
  id       Int    @id @default(autoincrement())
  title    String
  subject  String
  category String
  content  String
}

model MockTest {
  id              Int         @id @default(autoincrement())
  title           String
  mode            String
  durationMinutes Int
  subject         String?
  totalQuestions  Int
  questionsJson   String
  isPublished     Boolean     @default(true)
  mockScores      MockScore[]
}

model MockScore {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId       Int
  mockTest         MockTest @relation(fields: [mockTestId], references: [id])
  score            Int
  totalQuestions   Int
  timeTakenMinutes Int
  answersJson      String
  percentile       Float?
  createdAt        DateTime @default(now())
}

model Revision {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId     Int
  chapter       Chapter   @relation(fields: [chapterId], references: [id])
  status        String    @default("NOT_STARTED")
  revisionCount Int       @default(0)
  lastRevisedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, chapterId])
}

model Quiz {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  chapter       String?
  topic         String
  questionsJson String
  createdAt     DateTime @default(now())
}

model StudySession {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  durationMinutes Int
  date            DateTime @default(now())
}

model Analytics {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String
  score        Int
  totalAttempt Int
  date         DateTime @default(now())
}

model StudyPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      String
  planJson  String
  createdAt DateTime @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ExamPaper {
  id        Int      @id @default(autoincrement())
  state     String
  year      Int
  title     String
  shift     String?
  subject   String   @default("BiPC")
  examType  String   @default("EAPCET")
  fileUrl   String
  driveUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  sessionId String   @default("default")
  createdAt DateTime @default(now())
}
